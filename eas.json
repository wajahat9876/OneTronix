{
  "cli": {
    "version": ">= 2.8.0",
    "appVersionSource": "local"
  },
  "build": {
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "development-simulator"
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "cocoapods": "1.14.0"
      }
    },
    "preview2": {
        "ios": {
        "autoIncrement": true,
        "image": "sdk-52"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview2"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "ios": {
         "image": "sdk-52"
      }
    },
    "production": {
      "ios": {
        "autoIncrement": true,
        "image": "sdk-52"
      },
      "android": {
        "autoIncrement": true
      },
      "channel": "production"
    },
    "production-appstore": {
     
      "ios": {
        "autoIncrement": true,
        "image": "macos-sonoma-14.6-xcode-16.0"
      },
      "android": {
        "autoIncrement": true
      },
      "channel": "production-appstore"
    },
    "sqa": {
      "channel": "sqa",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "image": "macos-sonoma-14.6-xcode-16.0",
        "autoIncrement": true,
        "cocoapods": "1.14.0"
      }
    }
  },
  "submit": {
    // "sqa":{}
    "production": {}
  }
}
