{
  "expo": {
    "name": "OneTronix",
    "slug": "one-tronix",
    "version": "1.0.0",
    "newArchEnabled": false,
    "owner": "onetronix",
    "orientation": "portrait",
    "icon": "./assets/images/EccAdaptive.png",
    "scheme": "template",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/SplashIcon.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/1c712b9b-6d4f-4f59-a301-006412798e29"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow OneTronix to use Face ID for secure and easy authentication.",
        "ITSAppUsesNonExemptEncryption": false
      },
    
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/EccAdaptive.png",
        "backgroundColor": "#ffffff"
      },
      "package": "",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "OneTronix needs access to your camera to scan QR codes and capture your photo for identity verification.",
          "microphonePermission": "Allow OneTronix to access your microphone to enable voice-based features",
          "recordAudioAndroid": true
        }
      ],
       [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5",
            "useFrameworks": "static"
          },
          "android": {
            "minSdkVersion": 29,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/SplashIcon.png",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OneTronix needs access to your photo library to upload images for verifying your identity.",
          "cameraPermission": "Allow OneTronix to access your camera to take photos for verifying your identity.",
          "//": "Disables the microphone permission",
          "microphonePermission": false
        }
      ],
      [
        "expo-document-picker"
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow OneTronix to use Face ID for secure and easy authentication."
        }
      ],
      "expo-asset"
      
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": ""
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
